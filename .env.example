# انسخ هذا الملف لـ .env (محليًا فقط — .env ما بينرفع على الريبو)
PORT=3000
# مفاتيح مزوّدي الذكاء الاصطناعي (اللي ما عندك اتركه فاضي)
AI_GROQ_KEY=
AI_QWEN_KEY=
AI_KIMI_KEY=
# توكن اختياري يحمي البروكسي (الواجهة لازم تبعته بـ x-ai-token)
AI_PROXY_TOKEN=
# الدومينات المسموح لها تنادي الـ API، مفصولة بفواصل (فاضي = الكل)
ALLOWED_ORIGINS=
# عدد البروكسيات قدّام السيرفر (رندر = 1)
TRUST_PROXY_HOPS=1
