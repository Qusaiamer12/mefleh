rules_version = '2';

/* ==========================================================
   قواعد أمان قاعدة البيانات — نظام كشوفات المستودع
   ----------------------------------------------------------
   الباك-إند الوحيد المكشوف للتطبيق هو مجموعة wh_sync.
   • القراءة والكتابة فقط لمن سجّل عبر التطبيق (توثيق مجهول
     داخلي — شاشة الدخول والصلاحيات تُدار من داخل النظام نفسه)
   • أي مسار آخر بالقاعدة مرفوض افتراضيًا
   النشر:  firebase deploy --only firestore:rules
   ========================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    match /wh_sync/{doc} {
      allow read, write: if request.auth != null;
    }

    /* رفض صريح لأي شي ثاني */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
