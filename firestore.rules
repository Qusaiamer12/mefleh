rules_version = '2';

/* ==========================================================
   قواعد أمان قاعدة البيانات — نظام كشوفات المستودع
   ----------------------------------------------------------
   الباك-إند الوحيد المكشوف للتطبيق هو مجموعة wh_sync.
   • القراءة والكتابة فقط لمن سجّل عبر التطبيق (توثيق مجهول
     داخلي — شاشة الدخول والصلاحيات تُدار من داخل النظام نفسه)
   • أي مسار آخر بالقاعدة مرفوض افتراضيًا
   النشر:  firebase deploy --only firestore:rules
   ========================================================== */
service cloud.firestore {
  match /databases/{database}/documents {

    match /wh_sync/{doc} {
      allow read: if request.auth != null;
      /* الكتابة بس على مفاتيح النظام (wh_…) وبنفس شكل القطع اللي بيكتبها
         التطبيق — ما بينفع تُستخدم كمخزن عام لأي بيانات ثانية */
      allow create, update: if request.auth != null
        && doc.matches('wh_[a-z0-9_]+')
        && request.resource.data.keys().hasOnly(['chunks', 'len', 't', 'i', 'd'])
        && (!('d' in request.resource.data) || request.resource.data.d is string);
      allow delete: if request.auth != null && doc.matches('wh_[a-z0-9_]+');
    }

    /* رفض صريح لأي شي ثاني */
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
